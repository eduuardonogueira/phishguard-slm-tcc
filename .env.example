# Copie para .env e preencha só o que for usar. O .env não vai para o git.
#   cp .env.example .env

# Hugging Face: token de leitura (https://huggingface.co/settings/tokens).
# Obrigatório para o Gemma 3 (gemma1b), que é restrito: aceite antes a licença em
# https://huggingface.co/google/gemma-3-1b-it com a mesma conta do token.
HF_TOKEN=

# Open PageRank (https://www.domcop.com/openpagerank/), usado pelo servidor para
# o atributo page_rank. Sem chave, o atributo fica fora do prompt.
# Atenção: envia o domínio visitado a um serviço externo.
OPENPAGERANK_API_KEY=
